# Armazenamento das estatísticas globais (Redis via REST).
# Na Vercel: Storage -> Marketplace -> Upstash Redis -> Connect Project.
# Isso preenche as variáveis abaixo sozinho (KV_REST_API_URL / KV_REST_API_TOKEN
# ou UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN). Os dois pares funcionam.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# (opcional) Data do mergulho nº 1, formato AAAA-MM-DD. Padrão: 2026-10-08
ABISSO_LANCAMENTO=2026-10-08
